# AI Photo Studio Configuration
# Copy this file to .env and customize

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_DEBUG=false
SERVER_LOG_LEVEL=INFO

# --- GPU ---
GPU_DEVICE=auto
GPU_MAX_VRAM_USAGE_MB=3500
GPU_MIXED_PRECISION=true
GPU_TILE_SIZE=256
GPU_IDLE_UNLOAD_SECONDS=300

# --- Storage ---
STORAGE_MAX_UPLOAD_SIZE_MB=50
STORAGE_MAX_OUTPUT_RETENTION_DAYS=30
